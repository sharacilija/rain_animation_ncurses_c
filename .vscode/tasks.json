{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ncurses",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "ncurses_animation.c",
                "-o",
                "ncurses_animation.exe",
                "-Wall",
                "-Wextra",
                "-std=c17",
                "-lncursesw"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}